#!/usr/bin/env sh
set -e

if ! command -v task >/dev/null 2>&1; then
  echo "pre-commit: 'task' not found (brew install go-task). Skipping checks." >&2
  exit 0
fi

# Run from the repo root regardless of where `git commit` was invoked.
cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: running task check..."
task check
